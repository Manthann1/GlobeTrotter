{
  "name": "globetrotter-backend",
  "version": "1.0.0",
  "description": "GlobeTrotter Backend API & Database Service",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "db:init-local": "powershell -ExecutionPolicy Bypass -File ./scripts/init_local_db.ps1",
    "db:start-local": "powershell -ExecutionPolicy Bypass -File ./scripts/start_local_db.ps1"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [
    "globetrotter",
    "travel-planner",
    "pern",
    "postgresql",
    "prisma",
    "express",
    "nodejs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^6.4.1"
  }
}
